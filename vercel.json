{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/auth.ts": {
      "includeFiles": "backend-dist/**"
    },
    "api/index.ts": {
      "includeFiles": "backend-dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ]
}
